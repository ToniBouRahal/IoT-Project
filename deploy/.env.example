# Copy this to .env and fill in all values before deploying.

# PostgreSQL
POSTGRES_DB=safetydb
POSTGRES_USER=safety
POSTGRES_PASSWORD=change-this-db-password

# Backend
DATABASE_URL=postgresql+asyncpg://safety:change-this-db-password@postgres:5432/safetydb
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=backend
MQTT_PASSWORD=change-this-backend-mqtt-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=alerts@devdungeons.com
ALERT_RECIPIENTS=owner@example.com
JWT_SECRET=change-this-to-a-64-char-random-string
CORS_ORIGINS=https://dashboard.devdungeons.com

# Traefik — replace with the actual server's Let's Encrypt email
ACME_EMAIL=admin@devdungeons.com

# Cloudflare DNS challenge — create a scoped API token at:
# https://dash.cloudflare.com/profile/api-tokens
# Permissions required: Zone → DNS → Edit  (for your domain's zone)
CF_DNS_API_TOKEN=your-cloudflare-api-token
